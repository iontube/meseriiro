---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  /** dimensiunile reale ale ogImage (pt articole hero 16:9 = 1600x900; default social 1200x630). */
  ogImageWidth?: number;
  ogImageHeight?: number;
  noindex?: boolean;
  /** noindex dar cu follow (link equity curge mai departe). Pt pagini thin scoase din index dar utile navigării. */
  noindexFollow?: boolean;
  jsonLd?: string[];
  /** false => titlul rămâne exact cum e dat (fără sufix de brand). Pt articole. */
  appendSite?: boolean;
  /** paginare: URL-uri absolute către pagina anterioară/următoare (pt Bing; Google le ignoră). */
  relPrev?: string;
  relNext?: string;
  /** pt articole (Discover + rich): datele de publicare/modificare ISO. */
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  noindex = false,
  noindexFollow = false,
  jsonLd = [],
  appendSite = true,
  relPrev,
  relNext,
  publishedTime,
  modifiedTime,
} = Astro.props;

const siteUrl = 'https://meseriile.ro';
const fullCanonical = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${Astro.url.pathname}`;
const fullTitle = !appendSite || title.length > 50 || title.includes('Director Meserii')
  ? title
  : `${title} | Director Meserii în România`;
// ogImage poate fi URL absolut (hero pe R2) sau cale relativă pe meseriile.ro
const fullOgImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`)
  : `${siteUrl}/og-default.png`;
const now = new Date().toISOString();
---

<!-- Primary Meta -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={fullCanonical} />
{relPrev && <link rel="prev" href={relPrev} />}
{relNext && <link rel="next" href={relNext} />}
{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : noindexFollow
  ? <meta name="robots" content="noindex, follow" />
  : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="article:modified_time" content={modifiedTime ?? now} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={fullCanonical} />
<meta property="og:site_name" content="Director Meserii în România" />
<meta property="og:locale" content="ro_RO" />
<meta property="og:image" content={fullOgImage} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullOgImage} />

<!-- JSON-LD -->
{jsonLd.map(schema => (
  <script type="application/ld+json" set:html={schema} />
))}
