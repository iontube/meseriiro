---
import Layout from '../layouts/Layout.astro';
import SEOHead from '../components/SEOHead.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQSection from '../components/FAQSection.astro';
import SalaryCalculator from '../components/SalaryCalculator.astro';
import { getPopularMeserii } from '../helpers/interlinking';
import { buildBreadcrumbSchema, buildFAQSchema, buildWebPageSchema } from '../helpers/structured-data';

const populare = getPopularMeserii(8);
const anul = new Date().getFullYear();

const breadcrumbs = [
  { label: 'Calculator salariu' },
];

const webAppSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `Calculator salariu net ${anul}`,
  url: 'https://meseriile.ro/calculator-salariu/',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires JavaScript',
  inLanguage: 'ro-RO',
  description: 'Calculator online pentru conversia salariului brut în net și invers, cu CAS, CASS, impozit, deducere personală, tichete de masă și cost total angajator, actualizat pentru 2026.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'RON' },
  publisher: {
    '@type': 'Organization',
    name: 'Meseriile.ro',
    url: 'https://meseriile.ro/',
  },
});

const faqItems = [
  {
    intrebare: 'Cum se calculează salariul net din brut în 2026?',
    raspuns: 'Din salariul brut se rețin trei contribuții ale angajatului: CAS (pensie) 25%, CASS (sănătate) 10% și impozitul pe venit de 10%. Impozitul se aplică pe brut după scăderea CAS, CASS și a deducerii personale. Ce rămâne este salariul net, banii primiți efectiv în cont.',
  },
  {
    intrebare: 'Ce este deducerea personală și cui i se aplică?',
    raspuns: 'Deducerea personală este o sumă scutită de impozit, acordată salariaților cu venit brut de până la salariul minim plus 2.000 lei (adică până la 6.325 lei brut în semestrul doi din 2026). Se calculează ca procent din salariul brut, procent care scade pe măsură ce salariul crește și urcă în funcție de numărul de persoane în întreținere. Peste plafon, deducerea este zero.',
  },
  {
    intrebare: 'Cât reprezintă netul din brut, procentual?',
    raspuns: 'Pentru salariile peste 6.325 lei brut, unde deducerea personală nu se mai aplică, netul este aproximativ 58,5% din brut. Sub acest prag, procentul este ceva mai mare, pentru că deducerea personală reduce impozitul.',
  },
  {
    intrebare: 'Cât costă angajatorul un salariat, în plus față de brut?',
    raspuns: 'Angajatorul plătește peste salariul brut contribuția asiguratorie pentru muncă (CAM) de 2,25%. Astfel, costul total al unui angajat este brutul înmulțit cu 1,0225, la care se adaugă eventualele tichete de masă.',
  },
  {
    intrebare: 'Mai există scutirea de impozit pentru IT, construcții sau agricultură?',
    raspuns: 'Nu. Facilitățile fiscale pentru IT, construcții și agricultură au fost eliminate începând cu 1 ianuarie 2025 prin OUG 156/2024. În 2026 se aplică o singură formulă de calcul pentru toți salariații.',
  },
  {
    intrebare: 'Ce salariu minim brut se folosește în 2026?',
    raspuns: `Salariul minim brut pe economie este de 4.325 lei pe lună începând cu 1 iulie 2026 (în prima jumătate a anului a fost 4.050 lei). Această valoare este reperul pentru deducerea personală și pentru facilitatea celor 200 de lei neimpozabili la salariul minim.`,
  },
];
---

<Layout>
  <SEOHead
    slot="head"
    title={`Calculator salariu net ${anul} - brut în net și net în brut`}
    description="Calculator salariu net brut 2026: convertește brutul în net și netul în brut, cu CAS, CASS, impozit, deducere personală, tichete de masă și cost total angajator. Gratuit și instant."
    canonical="/calculator-salariu/"
    jsonLd={[
      buildBreadcrumbSchema(breadcrumbs),
      webAppSchema,
      buildWebPageSchema(
        `Calculator salariu net ${anul}`,
        'Calculator online salariu net brut pentru România, actualizat 2026.',
        'https://meseriile.ro/calculator-salariu/'
      ),
      buildFAQSchema(faqItems),
    ]}
  />

  <div class="container-custom">
    <Breadcrumb items={breadcrumbs} />
  </div>

  <div class="container-narrow pb-16 sm:pb-20">
    <header class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-heading font-extrabold text-surface-900 mb-4">
        Calculator salariu net {anul}
      </h1>
      <p class="text-lg text-surface-700 leading-relaxed">
        Transformă salariul brut în net sau invers, cu toate contribuțiile la zi: CAS, CASS, impozit, deducere personală, tichete de masă și costul total pentru angajator.
      </p>
    </header>

    <div class="mb-12">
      <SalaryCalculator mod="brut" valoare={5000} />
    </div>

    <!-- Cum funcționează -->
    <section class="mb-12">
      <h2 class="text-2xl font-heading font-bold text-surface-900 mb-4">Cum se calculează salariul net</h2>
      <p class="text-surface-700 leading-relaxed mb-3">
        Din salariul brut, angajatorul reține trei sume și le virează la stat în numele tău.
      </p>
      <ul class="space-y-2 mb-4 text-surface-700">
        <li class="flex items-start gap-2"><span class="text-brand-500 mt-1 shrink-0">·</span><span><strong>CAS – contribuția la pensie:</strong> 25% din brut.</span></li>
        <li class="flex items-start gap-2"><span class="text-brand-500 mt-1 shrink-0">·</span><span><strong>CASS – contribuția la sănătate:</strong> 10% din brut.</span></li>
        <li class="flex items-start gap-2"><span class="text-brand-500 mt-1 shrink-0">·</span><span><strong>Impozit pe venit:</strong> 10%, aplicat pe brut după scăderea CAS, CASS și a deducerii personale.</span></li>
      </ul>
      <p class="text-surface-700 leading-relaxed">
        Ce rămâne după cele trei rețineri este salariul net, banii care ajung efectiv în contul tău.
      </p>
    </section>

    <!-- Exemplu -->
    <section class="mb-12">
      <h2 class="text-2xl font-heading font-bold text-surface-900 mb-4">Exemplu: 6.000 lei brut</h2>
      <p class="text-surface-700 leading-relaxed mb-4">
        Pentru un salariu de 6.000 lei brut, fără persoane în întreținere, calculul arată așa:
      </p>
      <div class="card p-0 overflow-hidden">
        <table class="w-full text-sm">
          <tbody class="divide-y divide-surface-100">
            <tr><td class="px-5 py-3 text-surface-600">Salariu brut</td><td class="px-5 py-3 text-right font-semibold text-surface-900 tabular-nums">6.000 lei</td></tr>
            <tr><td class="px-5 py-3 text-surface-600">CAS (25%)</td><td class="px-5 py-3 text-right text-surface-700 tabular-nums">− 1.500 lei</td></tr>
            <tr><td class="px-5 py-3 text-surface-600">CASS (10%)</td><td class="px-5 py-3 text-right text-surface-700 tabular-nums">− 600 lei</td></tr>
            <tr><td class="px-5 py-3 text-surface-600">Deducere personală</td><td class="px-5 py-3 text-right text-emerald-600 tabular-nums">180 lei</td></tr>
            <tr><td class="px-5 py-3 text-surface-600">Bază impozabilă</td><td class="px-5 py-3 text-right text-surface-700 tabular-nums">3.720 lei</td></tr>
            <tr><td class="px-5 py-3 text-surface-600">Impozit (10%)</td><td class="px-5 py-3 text-right text-surface-700 tabular-nums">− 372 lei</td></tr>
            <tr class="bg-brand-50"><td class="px-5 py-3.5 font-bold text-surface-900">Salariu net</td><td class="px-5 py-3.5 text-right font-bold text-brand-700 tabular-nums">3.528 lei</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-surface-500 mt-3">
        Calculul folosește salariul minim de 4.325 lei valabil din 1 iulie 2026. Vezi <a href="/despre-date/" class="text-link">metodologia noastră</a>.
      </p>
    </section>

    <!-- Interlink meserii -->
    <section class="mb-12">
      <h2 class="text-2xl font-heading font-bold text-surface-900 mb-2">Vezi salariul pe meserie</h2>
      <p class="text-surface-600 mb-5">Câți bani iei net la mână, pe cele mai căutate meserii din România.</p>
      <div class="grid sm:grid-cols-2 gap-3">
        {populare.map(link => (
          <a href={link.href} class="card p-4 no-underline group flex items-center justify-between">
            <span class="font-medium text-surface-800 group-hover:text-brand-600 transition-colors">{link.text}</span>
            <svg aria-hidden="true" class="w-4 h-4 text-surface-400 group-hover:text-brand-500 transition-colors shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        ))}
      </div>
      <div class="mt-4">
        <a href="/salariu/" class="text-link font-medium">Toate salariile pe meserii →</a>
      </div>
    </section>

    <FAQSection items={faqItems} />
  </div>
</Layout>
