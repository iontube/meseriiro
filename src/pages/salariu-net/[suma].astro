---
import Layout from '../../layouts/Layout.astro';
import SEOHead from '../../components/SEOHead.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQSection from '../../components/FAQSection.astro';
import SalaryCalculator from '../../components/SalaryCalculator.astro';
import { meserii, formatSalariu } from '../../helpers/data';
import { brutToNet } from '../../helpers/salariu-calc';
import { buildBreadcrumbSchema, buildFAQSchema, buildWebPageSchema } from '../../helpers/structured-data';

// Set curat de sume rotunde CĂUTATE (dens în zona de masă 2.000-8.000, rar peste 10.000).
function sumeUzuale(): number[] {
  const set = new Set<number>();
  for (let v = 2000; v <= 8000; v += 250) set.add(v);
  for (let v = 8500; v <= 10000; v += 500) set.add(v);
  for (let v = 11000; v <= 20000; v += 1000) set.add(v);
  [4050, 4325, 25000, 30000].forEach(v => set.add(v)); // minime + iconice
  return [...set].sort((a, b) => a - b);
}
const SUME = sumeUzuale();

export function getStaticPaths() {
  const set = new Set<number>();
  for (let v = 2000; v <= 8000; v += 250) set.add(v);
  for (let v = 8500; v <= 10000; v += 500) set.add(v);
  for (let v = 11000; v <= 20000; v += 1000) set.add(v);
  [4050, 4325, 25000, 30000].forEach(v => set.add(v));
  const sume = [...set].sort((a, b) => a - b);
  return sume.map(val => ({ params: { suma: `${val}-lei-brut` }, props: { val } }));
}

interface Props { val: number; }
const { val } = Astro.props;

const r = brutToNet(val);
const anul = new Date().getFullYear();
const procentNet = Math.round((r.net / val) * 1000) / 10; // ex. 58.5

// Meserii cu salariul mediu (net) apropiat de acest net -> interlink spre /salariu/<slug>/
const meseriiApropiate = [...meserii]
  .map(m => ({ m, dist: Math.abs(m.salpiuNational.mediu - r.net) }))
  .sort((a, b) => a.dist - b.dist)
  .slice(0, 8)
  .map(x => x.m);

// Sume vecine pentru interlink
const idx = SUME.indexOf(val);
const vecine = [SUME[idx - 2], SUME[idx - 1], SUME[idx + 1], SUME[idx + 2]].filter(Boolean);

const breadcrumbs = [
  { label: 'Calculator salariu', href: '/calculator-salariu/' },
  { label: 'Salariu net din brut', href: '/salariu-net/' },
  { label: `${formatSalariu(val)} brut` },
];

const faqItems = [
  {
    intrebare: `Cât este netul din ${formatSalariu(val)} brut în ${anul}?`,
    raspuns: `Un salariu brut de ${formatSalariu(val)} înseamnă ${formatSalariu(r.net)} net pe lună în ${anul}. Din brut se rețin CAS ${formatSalariu(r.cas)}, CASS ${formatSalariu(r.cass)} și impozit ${formatSalariu(r.impozit)}${r.deducere > 0 ? `, după aplicarea deducerii personale de ${formatSalariu(r.deducere)}` : ''}.`,
  },
  {
    intrebare: `Cât îl costă pe angajator un salariu de ${formatSalariu(val)} brut?`,
    raspuns: `Costul total pentru angajator este de ${formatSalariu(r.cost)} pe lună, adică brutul de ${formatSalariu(val)} plus contribuția asiguratorie pentru muncă (CAM) de 2,25%.`,
  },
  {
    intrebare: `Ce procent din ${formatSalariu(val)} brut rămâne net?`,
    raspuns: `Din ${formatSalariu(val)} brut rămân ${procentNet}% net, adică ${formatSalariu(r.net)}. Restul de ${Math.round(100 - procentNet)}% reprezintă contribuțiile sociale și impozitul reținute la sursă.`,
  },
];

const linii = [
  { label: 'Salariu brut', val: formatSalariu(r.brut), tone: 'base' },
  { label: 'CAS – pensie (25%)', val: '− ' + formatSalariu(r.cas), tone: 'minus' },
  { label: 'CASS – sănătate (10%)', val: '− ' + formatSalariu(r.cass), tone: 'minus' },
  ...(r.deducere > 0 ? [{ label: 'Deducere personală', val: '+ ' + formatSalariu(r.deducere), tone: 'plus' }] : []),
  { label: 'Impozit pe venit (10%)', val: '− ' + formatSalariu(r.impozit), tone: 'minus' },
];
---

<Layout>
  <SEOHead
    slot="head"
    title={`${formatSalariu(val)} brut = ${formatSalariu(r.net)} net în ${anul}`}
    description={`Salariu ${formatSalariu(val)} brut înseamnă ${formatSalariu(r.net)} net pe lună în ${anul}. Vezi defalcarea CAS, CASS, impozit, deducere și costul total pentru angajator.`}
    canonical={`/salariu-net/${val}-lei-brut/`}
    ogType="article"
    jsonLd={[
      buildBreadcrumbSchema(breadcrumbs),
      buildWebPageSchema(`${formatSalariu(val)} brut în net`, `Conversie ${formatSalariu(val)} brut în net pentru ${anul}.`, `https://meseriile.ro/salariu-net/${val}-lei-brut/`),
      buildFAQSchema(faqItems),
    ]}
  />

  <div class="container-custom">
    <Breadcrumb items={breadcrumbs} />
  </div>

  <div class="container-narrow pb-16 sm:pb-20">
    <header class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-heading font-extrabold text-surface-900 mb-4">
        {formatSalariu(val)} brut = <span class="text-brand-700">{formatSalariu(r.net)}</span> net
      </h1>
      <p class="text-lg text-surface-700 leading-relaxed">
        Un salariu de {formatSalariu(val)} brut înseamnă {formatSalariu(r.net)} net pe lună în {anul}, adică {procentNet}% din brut. Mai jos ai defalcarea completă și calculatorul, dacă vrei să schimbi suma.
      </p>
    </header>

    <!-- Defalcare statică (server-rendered, pentru SEO) -->
    <div class="card p-6 mb-8">
      <h2 class="text-lg font-heading font-bold text-surface-900 mb-4">Defalcare {formatSalariu(val)} brut</h2>
      <dl class="text-sm divide-y divide-surface-100">
        {linii.map(l => (
          <div class="flex items-center justify-between py-2.5">
            <dt class="text-surface-600">{l.label}</dt>
            <dd class:list={['font-medium tabular-nums', l.tone === 'plus' ? 'text-emerald-600' : l.tone === 'base' ? 'text-surface-900 font-semibold' : 'text-surface-700']}>{l.val}</dd>
          </div>
        ))}
        <div class="flex items-center justify-between py-3 border-t-2 border-surface-200">
          <dt class="font-semibold text-surface-900">Salariu net în mână</dt>
          <dd class="font-bold text-brand-700 tabular-nums">{formatSalariu(r.net)}</dd>
        </div>
      </dl>
      <div class="grid grid-cols-2 gap-3 mt-4">
        <div class="rounded-card bg-surface-50 border border-surface-200 p-3.5 text-center">
          <p class="text-xs text-surface-500 font-medium mb-0.5">Cost total angajator</p>
          <p class="text-lg font-heading font-bold text-surface-800 tabular-nums">{formatSalariu(r.cost)}</p>
        </div>
        <div class="rounded-card bg-surface-50 border border-surface-200 p-3.5 text-center">
          <p class="text-xs text-surface-500 font-medium mb-0.5">Brut pe oră</p>
          <p class="text-lg font-heading font-bold text-surface-800 tabular-nums">{formatSalariu(r.ora)}</p>
        </div>
      </div>
    </div>

    <!-- Calculator interactiv pre-completat -->
    <section class="mb-10">
      <SalaryCalculator
        mod="brut"
        valoare={val}
        titlu="Schimbă suma"
        context="Modifică brutul sau treci pe net → brut pentru orice alt scenariu."
      />
    </section>

    <!-- Meserii care câștigă cam atât (interlink spre axa meserii) -->
    {meseriiApropiate.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-heading font-bold text-surface-900 mb-2">Ce meserii câștigă în jur de {formatSalariu(r.net)} net</h2>
        <p class="text-surface-600 mb-5">Meserii cu salariul mediu apropiat de această sumă. Vezi salariul detaliat pe orașe.</p>
        <div class="grid sm:grid-cols-2 gap-3">
          {meseriiApropiate.map(m => (
            <a href={`/salariu/${m.slug}/`} class="card p-4 no-underline group flex items-center justify-between">
              <span class="font-medium text-surface-800 group-hover:text-brand-600 transition-colors">{m.nume}</span>
              <span class="text-sm font-bold text-brand-700 tabular-nums">{formatSalariu(m.salpiuNational.mediu)}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Sume vecine (interlink între paginile-sumă) -->
    {vecine.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-heading font-bold text-surface-900 mb-4">Sume apropiate</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {vecine.map(v => (
            <a href={`/salariu-net/${v}-lei-brut/`} class="card p-4 no-underline text-center group">
              <span class="block font-semibold text-surface-800 group-hover:text-brand-600 transition-colors tabular-nums">{formatSalariu(v)}</span>
              <span class="block text-xs text-surface-500">brut</span>
            </a>
          ))}
        </div>
        <div class="mt-4">
          <a href="/salariu-net/" class="text-link font-medium">Vezi tabelul cu toate sumele →</a>
        </div>
      </section>
    )}

    <FAQSection items={faqItems} />
  </div>
</Layout>
